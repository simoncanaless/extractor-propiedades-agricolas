# Copia este archivo como .env y completa tus valores.

# Proveedor de IA activo: groq o gemini
LLM_PROVIDER=groq

# Groq: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_aqui
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (opcional): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agricola_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

# Servidor Flask
FLASK_PORT=5001
FLASK_DEBUG=1
